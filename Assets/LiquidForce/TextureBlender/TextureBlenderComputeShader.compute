#pragma kernel BlendTexturesArrayAdditive
#pragma kernel BlendTexturesArrayAlphaWeighted
#pragma kernel BlendTexturesArrayMultiplicative
#pragma kernel BlendNormalsWithBaseAlphaAdditive
#pragma kernel BlendNormalsWithBaseAlphaAlphaWeighted
#pragma kernel BlendNormalsWithBaseAlphaMultiplicative

// Output texture and buffer (VR compatibility - write to both)
RWTexture2D<float4> OutputTexture;
RWStructuredBuffer<float4> OutputBuffer;

// Input textures as Texture2DArray (removes 8-texture limit)
Texture2DArray<float4> InputTexturesArray;

// Base textures array for per-pixel alpha sampling (used for normal blending)
Texture2DArray<float4> BaseTexturesArray;

// Blend weights for each texture layer
StructuredBuffer<float> BlendValues;

// Rotation angles in radians for each texture layer (0 = no rotation)
StructuredBuffer<float> RotationAngles;

// UV offsets for each texture layer (float2 per texture: offsetX, offsetY)
// Stored as interleaved floats: [tex0.x, tex0.y, tex1.x, tex1.y, ...]
StructuredBuffer<float> UVOffsets;

// Parameters
int TextureCount;
int TextureWidth;
int TextureHeight;

// Custom inline sampler with Wrap mode for tiling during rotation and offset
// Format: SamplerState sampler<TextureName> creates an inline sampler
// Linear filtering with Wrap address mode ensures smooth tiling when UV goes out of [0,1] bounds
SamplerState sampler_linear_repeat;


/// <summary>
/// Transforms UV coordinates: applies offset, then rotates around center point (0.5, 0.5).
/// UVs automatically tile/wrap due to Wrap sampler state (AddressU/V = Wrap).
/// Out-of-bounds UVs wrap seamlessly for continuous tiling.
/// </summary>
/// <param name="uv">Original UV coordinates</param>
/// <param name="angleRadians">Rotation angle in radians</param>
/// <param name="offset">UV offset (x, y)</param>
float2 TransformUV(float2 uv, float angleRadians, float2 offset)
{
    // Apply offset first (wrapping handled by sampler)
    // Note: Subtract offset to move texture in intuitive direction (positive X = right, positive Y = up)
    float2 offsetUV = uv - offset;
    // Then rotate around center if needed
    if (abs(angleRadians) > 0.0001)  // Skip rotation if angle is ~zero
    {
        // Translate to origin (rotate around center)
        float2 centered = offsetUV - 0.5;
        // Apply 2D rotation matrix
        float cosAngle = cos(angleRadians);
        float sinAngle = sin(angleRadians);
        float2 rotated;
        rotated.x = centered.x * cosAngle - centered.y * sinAngle;
        rotated.y = centered.x * sinAngle + centered.y * cosAngle;
        // Translate back (wrapping handled by sampler)
        return rotated + 0.5;
    }
    return offsetUV;
}/// <summary>
/// Rotates UV coordinates around center point (0.5, 0.5) by given angle in radians.
/// UVs automatically tile/wrap due to Wrap sampler state (AddressU/V = Wrap).
/// Out-of-bounds UVs wrap seamlessly during rotation for continuous tiling.
/// </summary>
float2 RotateUV(float2 uv, float angleRadians)
{
    // Translate to origin (rotate around center)
    float2 centered = uv - 0.5;
    
    // Apply 2D rotation matrix
    float cosAngle = cos(angleRadians);
    float sinAngle = sin(angleRadians);
    float2 rotated;
    rotated.x = centered.x * cosAngle - centered.y * sinAngle;
    rotated.y = centered.x * sinAngle + centered.y * cosAngle;
    
    // Translate back (wrapping handled by sampler)
    return rotated + 0.5;
}

/// <summary>
/// Converts a linear color value back to sRGB space.
/// Unity automatically converts sRGB textures to Linear when sampling, so this undoes that conversion
/// to get back the original texture values for exact value matching.
/// </summary>
float4 LinearToSRGB(float4 linearColor)
{
    float4 sRGB;
    sRGB.r = (linearColor.r <= 0.0031308) ? linearColor.r * 12.92 : 1.055 * pow(linearColor.r, 1.0/2.4) - 0.055;
    sRGB.g = (linearColor.g <= 0.0031308) ? linearColor.g * 12.92 : 1.055 * pow(linearColor.g, 1.0/2.4) - 0.055;
    sRGB.b = (linearColor.b <= 0.0031308) ? linearColor.b * 12.92 : 1.055 * pow(linearColor.b, 1.0/2.4) - 0.055;
    sRGB.a = linearColor.a;
    return sRGB;
}


/// <summary>
/// Additive blending kernel - Simple weighted sum of all textures.
/// PERFORMANCE: Fastest blend mode (~30% faster than alpha-weighted).
/// Each texture is multiplied by its blend weight and summed together.
/// </summary>
/// <remarks>
/// Thread group size [8,8,1] provides optimal GPU occupancy on RTX series GPUs (64 threads = 2 warps).
/// Loop unrolling happens automatically for small TextureCount values.
/// </remarks>
[numthreads(8,8,1)]
void BlendTexturesArrayAdditive(uint3 id : SV_DispatchThreadID)
{
    // Early exit if outside texture bounds
    if (id.x >= (uint)TextureWidth || id.y >= (uint)TextureHeight)
        return;
    
    // Calculate normalized UV coordinates for sampling
    float2 uv = (id.xy + 0.5) / float2(TextureWidth, TextureHeight);
    
    // Accumulate weighted color from all input textures
    float4 blendedColor = float4(0, 0, 0, 0);
    
    // Loop through all textures in array
    // For small TextureCount (<8), compiler will unroll this loop for maximum speed
    for (int i = 0; i < TextureCount; i++)
    {
        // Get UV offset for this texture (stored as interleaved x,y pairs)
        float2 offset = float2(UVOffsets[i * 2], UVOffsets[i * 2 + 1]);
        
        // Apply offset and rotation
        float2 transformedUV = TransformUV(uv, RotationAngles[i], offset);
        
        // Sample texture layer i from the texture array with transformed UV
        float4 sample = InputTexturesArray.SampleLevel(sampler_linear_repeat, float3(transformedUV, i), 0);
        
        // Convert back to sRGB to match original ImageProcessor.compute behavior
        sample = LinearToSRGB(sample);
        
        // Simple weighted addition
        blendedColor += sample * BlendValues[i];
    }
    
    // Write to both buffer and texture (VR/OpenGL ES 3.0 compatibility)
    OutputBuffer[id.y * TextureWidth + id.x] = blendedColor;
    OutputTexture[id.xy] = blendedColor;
}

/// <summary>
/// Alpha-weighted blending kernel - Original implementation using texture alpha channels.
/// Each texture's contribution is weighted by both its blend value and its own alpha channel.
/// This creates smooth transitions and proper transparency handling.
/// </summary>
/// <remarks>
/// Thread group size [8,8,1] provides optimal GPU occupancy on RTX series GPUs (64 threads = 2 warps).
/// Uses the same alpha-weighted blending formula as the original ImageProcessor.compute shader.
/// </remarks>
[numthreads(8,8,1)]
void BlendTexturesArrayAlphaWeighted(uint3 id : SV_DispatchThreadID)
{
    // Early exit if outside texture bounds
    if (id.x >= (uint)TextureWidth || id.y >= (uint)TextureHeight)
        return;
    
    // Calculate normalized UV coordinates for sampling
    float2 uv = (id.xy + 0.5) / float2(TextureWidth, TextureHeight);
    
    // Accumulate weighted color from all input textures
    float4 blendedColor = float4(0, 0, 0, 0);
    
    // Loop through all textures in array
    for (int i = 0; i < TextureCount; i++)
    {
        // Get UV offset for this texture (stored as interleaved x,y pairs)
        float2 offset = float2(UVOffsets[i * 2], UVOffsets[i * 2 + 1]);
        
        // Apply offset and rotation
        float2 transformedUV = TransformUV(uv, RotationAngles[i], offset);
        
        // Sample texture layer i from the texture array with transformed UV
        // Unity performs sRGB->Linear conversion because Texture2DArray is marked as sRGB (linear: false)
        float4 sample = InputTexturesArray.SampleLevel(sampler_linear_repeat, float3(transformedUV, i), 0);
        
        // Convert back to sRGB to match original ImageProcessor.compute behavior
        sample = LinearToSRGB(sample);
        
        // Alpha-weighted blending: blend intensity is controlled by both the blend weight and the sample's alpha
        float blendIntensity = BlendValues[i] * sample.a;
        blendedColor = blendedColor * (1.0 - blendIntensity) + sample * blendIntensity * sample.a;
    }
    
    // Write to both buffer and texture (VR/OpenGL ES 3.0 compatibility)
    OutputBuffer[id.y * TextureWidth + id.x] = blendedColor;
    OutputTexture[id.xy] = blendedColor;
}

/// <summary>
/// Multiplicative blending kernel - Multiplies texture colors together.
/// Useful for creating darkening/masking effects. Each texture multiplies the result.
/// Weight determines how much of the texture's darkening effect is applied (lerp with white).
/// </summary>
/// <remarks>
/// Thread group size [8,8,1] provides optimal GPU occupancy on RTX series GPUs (64 threads = 2 warps).
/// Starts with white (1,1,1,1) and multiplies each texture contribution.
/// </remarks>
[numthreads(8,8,1)]
void BlendTexturesArrayMultiplicative(uint3 id : SV_DispatchThreadID)
{
    // Early exit if outside texture bounds
    if (id.x >= (uint)TextureWidth || id.y >= (uint)TextureHeight)
        return;
    
    // Calculate normalized UV coordinates for sampling
    float2 uv = (id.xy + 0.5) / float2(TextureWidth, TextureHeight);
    
    // Start with white (multiplicative identity)
    float4 blendedColor = float4(1, 1, 1, 1);
    
    // Loop through all textures in array
    for (int i = 0; i < TextureCount; i++)
    {
        // Get UV offset for this texture (stored as interleaved x,y pairs)
        float2 offset = float2(UVOffsets[i * 2], UVOffsets[i * 2 + 1]);
        
        // Apply offset and rotation
        float2 transformedUV = TransformUV(uv, RotationAngles[i], offset);
        
        // Sample texture layer i from the texture array with transformed UV
        float4 sample = InputTexturesArray.SampleLevel(sampler_linear_repeat, float3(transformedUV, i), 0);
        
        // Convert back to sRGB to match original ImageProcessor.compute behavior
        sample = LinearToSRGB(sample);
        
        // Lerp between white (no effect) and sample color based on weight
        // Weight of 0 = no darkening, Weight of 1 = full texture multiply
        float4 weighted = lerp(float4(1,1,1,1), sample, BlendValues[i]);
        blendedColor *= weighted;
    }
    
    // Write to both buffer and texture (VR/OpenGL ES 3.0 compatibility)
    OutputBuffer[id.y * TextureWidth + id.x] = blendedColor;
    OutputTexture[id.xy] = blendedColor;
}

/// <summary>
/// Normal blending kernel with per-pixel alpha - Additive version.
/// Blends normals from the normal texture array, using the base texture's alpha for per-pixel weight modulation.
/// Each pixel's normal contribution is scaled by the corresponding base texture alpha at that pixel.
/// </summary>
[numthreads(8,8,1)]
void BlendNormalsWithBaseAlphaAdditive(uint3 id : SV_DispatchThreadID)
{
    // Early exit if outside texture bounds
    if (id.x >= (uint)TextureWidth || id.y >= (uint)TextureHeight)
        return;
    
    // Calculate normalized UV coordinates for sampling
    float2 uv = (id.xy + 0.5) / float2(TextureWidth, TextureHeight);
    
    // Accumulate weighted normal
    float4 blendedNormal = float4(0, 0, 0, 0);
    
    // Loop through all textures in array
    for (int i = 0; i < TextureCount; i++)
    {
        // Get UV offset for this texture (stored as interleaved x,y pairs)
        float2 offset = float2(UVOffsets[i * 2], UVOffsets[i * 2 + 1]);
        
        // Apply offset and rotation
        float2 transformedUV = TransformUV(uv, RotationAngles[i], offset);
        
        // Sample normal texture layer i with transformed UV
        float4 normalSample = InputTexturesArray.SampleLevel(sampler_linear_repeat, float3(transformedUV, i), 0);
        normalSample = LinearToSRGB(normalSample);
        
        // Sample base texture alpha with transformed UV
        float4 baseSample = BaseTexturesArray.SampleLevel(sampler_linear_repeat, float3(transformedUV, i), 0);
        baseSample = LinearToSRGB(baseSample);
        
        // Combine layer weight with base texture alpha at this pixel
        float weight = BlendValues[i] * baseSample.a;
        
        // Accumulate weighted normal
        blendedNormal += normalSample * weight;
    }
    
    // Write to both buffer and texture (VR/OpenGL ES 3.0 compatibility)
    OutputBuffer[id.y * TextureWidth + id.x] = blendedNormal;
    OutputTexture[id.xy] = blendedNormal;
}

/// <summary>
/// Normal blending kernel with per-pixel alpha - Alpha-weighted version.
/// Blends normals from the normal texture array, using the base texture's alpha for per-pixel weight modulation.
/// Each pixel's normal contribution is scaled by the corresponding base texture alpha at that pixel.
/// </summary>
[numthreads(8,8,1)]
void BlendNormalsWithBaseAlphaAlphaWeighted(uint3 id : SV_DispatchThreadID)
{
    // Early exit if outside texture bounds
    if (id.x >= (uint)TextureWidth || id.y >= (uint)TextureHeight)
        return;
    
    // Calculate normalized UV coordinates for sampling
    float2 uv = (id.xy + 0.5) / float2(TextureWidth, TextureHeight);
    
    // Accumulate weighted normal
    float4 blendedNormal = float4(0, 0, 0, 0);
    
    // Loop through all textures in array
    for (int i = 0; i < TextureCount; i++)
    {
        // Get UV offset for this texture (stored as interleaved x,y pairs)
        float2 offset = float2(UVOffsets[i * 2], UVOffsets[i * 2 + 1]);
        
        // Apply offset and rotation
        float2 transformedUV = TransformUV(uv, RotationAngles[i], offset);
        
        // Sample normal texture layer i with transformed UV
        float4 normalSample = InputTexturesArray.SampleLevel(sampler_linear_repeat, float3(transformedUV, i), 0);
        normalSample = LinearToSRGB(normalSample);
        
        // Sample base texture alpha with transformed UV
        float4 baseSample = BaseTexturesArray.SampleLevel(sampler_linear_repeat, float3(transformedUV, i), 0);
        baseSample = LinearToSRGB(baseSample);
        
        // Alpha-weighted blending: blend intensity controlled by layer weight, base alpha, and normal alpha
        float blendIntensity = BlendValues[i] * baseSample.a * normalSample.a;
        blendedNormal = blendedNormal * (1.0 - blendIntensity) + normalSample * blendIntensity * normalSample.a;
    }
    
    // Write to both buffer and texture (VR/OpenGL ES 3.0 compatibility)
    OutputBuffer[id.y * TextureWidth + id.x] = blendedNormal;
    OutputTexture[id.xy] = blendedNormal;
}

/// <summary>
/// Normal blending kernel with per-pixel alpha - Multiplicative version.
/// Blends normals from the normal texture array, using the base texture's alpha for per-pixel weight modulation.
/// Each pixel's normal contribution is scaled by the corresponding base texture alpha at that pixel.
/// </summary>
[numthreads(8,8,1)]
void BlendNormalsWithBaseAlphaMultiplicative(uint3 id : SV_DispatchThreadID)
{
    // Early exit if outside texture bounds
    if (id.x >= (uint)TextureWidth || id.y >= (uint)TextureHeight)
        return;
    
    // Calculate normalized UV coordinates for sampling
    float2 uv = (id.xy + 0.5) / float2(TextureWidth, TextureHeight);
    
    // Start with white (multiplicative identity)
    float4 blendedNormal = float4(1, 1, 1, 1);
    
    // Loop through all textures in array
    for (int i = 0; i < TextureCount; i++)
    {
        // Get UV offset for this texture (stored as interleaved x,y pairs)
        float2 offset = float2(UVOffsets[i * 2], UVOffsets[i * 2 + 1]);
        
        // Apply offset and rotation
        float2 transformedUV = TransformUV(uv, RotationAngles[i], offset);
        
        // Sample normal texture layer i with transformed UV
        float4 normalSample = InputTexturesArray.SampleLevel(sampler_linear_repeat, float3(transformedUV, i), 0);
        normalSample = LinearToSRGB(normalSample);
        
        // Sample base texture alpha with transformed UV
        float4 baseSample = BaseTexturesArray.SampleLevel(sampler_linear_repeat, float3(transformedUV, i), 0);
        baseSample = LinearToSRGB(baseSample);
        
        // Lerp between white (no effect) and normal sample based on weight * base alpha
        float4 weighted = lerp(float4(1,1,1,1), normalSample, BlendValues[i] * baseSample.a);
        blendedNormal *= weighted;
    }
    
    // Write to both buffer and texture (VR/OpenGL ES 3.0 compatibility)
    OutputBuffer[id.y * TextureWidth + id.x] = blendedNormal;
    OutputTexture[id.xy] = blendedNormal;
}
